# SKVASRA Live Games - set these in Vercel Settings > Environment Variables
# Create a NEW independent Supabase project. Do not commit real keys.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
SUPABASE_SECRET_KEY=sb_secret_your_private_server_only_key

# Official SK Vasra Facebook Page details (NOT a personal profile)
FACEBOOK_PAGE_ID=your_page_id
FACEBOOK_PAGE_ACCESS_TOKEN=your_meta_page_access_token
FACEBOOK_GRAPH_VERSION=v24.0

# A random string of at least 32 characters. Use SAME secret as GitHub Actions.
CRON_SECRET=replace_with_long_random_secret
